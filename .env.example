# =============================================================
# KoiThe Backend - Environment Configuration Template
# =============================================================
# Sao chép file này thành ".env" và cập nhật giá trị phù hợp.
#   cp .env.example .env
# KHÔNG ĐƯỢC commit file .env lên Git!
# =============================================================

# ── Docker Compose / Postgres ────────────────────────────────
POSTGRES_DB=milktea
POSTGRES_USER=milktea
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433
REDIS_PORT=6380
BACKEND_PORT=8081
JWT_SECRET=change-this-to-a-minimum-32-character-secret

# ── Spring Boot Host (chạy trực tiếp, không qua Docker) ─────
DB_URL=jdbc:postgresql://localhost:5433/milktea
DB_USERNAME=milktea
DB_PASSWORD=change-me
REDIS_HOST=localhost

# ── Cổng thanh toán VNPay (Sandbox) ─────────────────────────
# Đăng ký tài khoản sandbox tại: https://sandbox.vnpayment.vn
VNPAY_TMN_CODE=your-vnpay-tmn-code
VNPAY_HASH_SECRET=your-vnpay-hash-secret
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8088/api/payments/vnpay-return

# ── Cổng thanh toán MoMo (Sandbox) ──────────────────────────
# Đăng ký tài khoản sandbox tại: https://developers.momo.vn
MOMO_PARTNER_CODE=your-momo-partner-code
MOMO_ACCESS_KEY=your-momo-access-key
MOMO_SECRET_KEY=your-momo-secret-key
MOMO_PAY_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_RETURN_URL=http://localhost:8088/api/payments/momo-return
MOMO_IPN_URL=http://localhost:8088/api/payments/momo-ipn

# ── Thanh toán VietQR (Chuyển khoản ngân hàng Napas 247) ────
# VIETQR_BANK_ID: Mã ngân hàng (vd: MB, VCB, TCB, ACB...)
# VIETQR_ACCOUNT_NO: Số tài khoản nhận tiền
# VIETQR_ACCOUNT_NAME: Tên chủ tài khoản
# VIETQR_TEMPLATE: Mẫu QR (compact, compact2, qr_only, print)
# VIETQR_WEBHOOK_SECRET: Khóa bí mật để xác thực webhook callback
VIETQR_BANK_ID=MB
VIETQR_ACCOUNT_NO=your-bank-account-number
VIETQR_ACCOUNT_NAME=YOUR ACCOUNT NAME
VIETQR_TEMPLATE=compact2
VIETQR_WEBHOOK_SECRET=change-this-to-a-random-secret-key
